generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Transaction {
  id        String   @id @default(cuid())
  amount    Float
  type      String // "income" | "expense"
  category  String
  title     String
  date      DateTime
  createdAt DateTime @default(now())
}
